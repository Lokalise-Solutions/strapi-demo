WEBSITE_URL=http://localhost:3000 # Add the correct ENV var for this onto your hosting platform, point it to your production website.
ENVIRONMENT=development
PORT=3000

# Local: http://127.0.0.1:1337
# Strapi Cloud: https://<project>.strapiapp.com  (no /admin, no /api, no trailing slash)
NEXT_PUBLIC_API_URL=http://127.0.0.1:1337
PREVIEW_SECRET=preview_secret # must match strapi/.env PREVIEW_SECRET